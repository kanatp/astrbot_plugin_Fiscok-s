{
  "meme_config": {
    "describe" : "meme发送/获取相关配置",
    "type" : "object",
    "items" : {
      "meme_available" : {
        "describe" : "是否启用表情包功能",
        "type" : "bool",
        "default" : false
      },
      "meme_cache_size" : {
        "describe" : "表情包缓存大小，单位为条",
        "type" : "int",
        "default" : 200
      },
      "emoji_learn_max" : {
        "describe" : "bot偷取群友meme的最大概率（表情包数量为0时）",
        "type" : "float",
        "default" : 0.7
      },
      "emoji_learn_min" : {
        "describe" : "bot偷取群友meme的最小概率（表情包数量达到上限时）",
        "type" : "float",
        "default" : 0.02
      },
      "emoji_attach_positive" : {
        "describe" : "bot发言时携带meme的概率",
        "type" : "float",
        "default" : 0.7
      },
      "llm_provider_id" : {
        "describe" : "用于表情包描述生成的LLM Provider",
        "type" : "string",
        "default" : "",
        "_special" : "select_provider",
        "hint" : "留空时使用第一个可用的模型；辅助调用会自动关闭思考模式"
      },
      "placeholder_tag" : {
        "describe" : "LLM回复中表情包占位符的标签名",
        "type" : "string",
        "default" : "meme"
      }
    }
  },
  "segmented_parser_config": {
    "describe": "LLM回复换行分段解析器配置",
    "type": "object",
    "items": {
      "available": {
        "describe": "是否启用换行分段解析器",
        "type": "bool",
        "default": false
      },
      "send_interval": {
        "describe": "分段消息之间的发送间隔（秒）",
        "type": "float",
        "default": 0.5
      }
    }
  },
  "emotion_config": {
    "describe": "情绪与好感度系统配置",
    "type": "object",
    "items": {
      "available": {
        "describe": "是否启用情绪与好感度系统",
        "type": "bool",
        "default": false
      },
      "llm_provider_id": {
        "describe": "用于情绪/好感度分析的LLM Provider（高温度）",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空时使用第一个可用的模型；辅助调用会自动关闭思考模式"
      },
      "temperature": {
        "describe": "情绪分析模型的温度（高温度设置）",
        "type": "float",
        "default": 1.2
      },
      "emotion_init": {
        "describe": "模型全局情绪的初始状态（文字描述）",
        "type": "string",
        "default": "平静"
      },
      "affinity_init": {
        "describe": "新用户好感度初始值",
        "type": "int",
        "default": 50
      },
      "affinity_min": {
        "describe": "好感度值下限",
        "type": "int",
        "default": 0
      },
      "affinity_max": {
        "describe": "好感度值上限",
        "type": "int",
        "default": 100
      },
      "delta_max": {
        "describe": "单次好感度变化值绝对值上限",
        "type": "int",
        "default": 5
      }
    }
  },
  "twitter_subscription_config": {
    "describe": "twitter订阅相关配置",
    "type": "object",
    "items": {
      "twitter_subscription_available": {
        "describe": "是否启动twitter订阅功能",
        "type": "bool",
        "default": false
      },
      "twitter_push_cache_size": {
        "describe": "twitter推送的缓存大小，单位为条",
        "type": "int",
        "default": 100
      },
      "twitter_push_time": {
        "describe": "twitter推送的时间",
        "type": "list",
        "default": [
          "08:00",
          "13:00",
          "19:00",
          "23:00"
        ]
      },
      "twitter_push_cache_time": {
        "describe": "更新推特订阅缓存的时间间隔，单位为小时",
        "type": "int",
        "default": 1
      },
      "rssHub_url": {
        "describe": "rssHub接口地址",
        "type": "string",
        "default": "127.0.0.1"
      },
      "rssHub_port": {
        "describe": "rssHub接口端口",
        "type": "int",
        "default": 1200
      },
      "twitter_fetch_interval": {
        "describe": "拉取不同推特账号之间的间隔（秒）",
        "type": "int",
        "default": 180,
        "hint": "过小可能导致推特账号触发风控；此值默认与原行为一致"
      },
      "twitter_push_interval": {
        "describe": "向不同群聊推送之间的间隔（秒）",
        "type": "float",
        "default": 20,
        "hint": "过小可能导致合并转发消息发送失败；此值默认与原行为一致"
      }
    }
  },
  "instagram_subscription_config": {
    "describe": "Instagram订阅相关配置",
    "type": "object",
    "items": {
      "instagram_subscription_available": {
        "describe": "是否启用Instagram订阅功能",
        "type": "bool",
        "default": false
      },
      "instagram_push_time": {
        "describe": "Instagram推送时间",
        "type": "list",
        "default": [
          "09:00",
          "15:00",
          "21:00"
        ]
      },
      "instagram_push_cache_size": {
        "describe": "Instagram推送缓存大小，单位为条",
        "type": "int",
        "default": 50
      },
      "instagram_fetch_stories": {
        "describe": "是否拉取快拍（Stories）",
        "type": "bool",
        "default": true
      },
      "instagram_fetch_interval": {
        "describe": "拉取间隔（小时），防止限流",
        "type": "int",
        "default": 1
      }
    }
  },
  "topic_memory_config": {
    "describe": "话题记忆（词向量检索）配置",
    "type": "object",
    "items": {
      "available": {
        "describe": "是否启用话题记忆功能",
        "type": "bool",
        "default": false
      },
      "embedding_provider_id": {
        "describe": "用于话题词向量的 Embedding Provider ID",
        "type": "string",
        "default": "",
        "hint": "手动填写在 AstrBot 中已配置的 Embedding 模型 Provider 的 ID（如 ollama/bge-m3）。留空时自动使用第一个可用的 Embedding Provider；未配置 Embedding Provider 时该功能自动禁用。注意：本项不使用下拉选择器，因 AstrBot 的 select_provider 只列出对话模型"
      },
      "llm_provider_id": {
        "describe": "用于话题判定/抽取的LLM Provider",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "留空时使用第一个可用的模型；辅助调用会自动关闭思考模式"
      },
      "max_topics": {
        "describe": "记忆上限（最大话题条数），超出按时间淘汰最旧",
        "type": "int",
        "default": 300
      },
      "min_similarity": {
        "describe": "记忆下限（相似度阈值），低于该值的话题不注入",
        "type": "float",
        "default": 0.5
      },
      "retrieve_top_k": {
        "describe": "单次检索最多注入的话题条数",
        "type": "int",
        "default": 3
      },
      "analyze_probability": {
        "describe": "触发后台话题判定的概率（用于节流辅助LLM成本）",
        "type": "float",
        "default": 0.2
      }
    }
  }
}